[Unit]
Description=JetBrains Mellum2 12B MoE GPU %i Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mellum2-instance-runner %i
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
