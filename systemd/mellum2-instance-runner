#!/usr/bin/env bash
# Runner for Mellum2 12B MoE GPU backend instance under systemd
set -euo pipefail

gpu_id="${1:-0}"
port=$((8001 + gpu_id))
runtime="${RUNTIME:-/nix/store/f57pns4a5iyzf54zvbr8sgr92y9s57nf-vega-runtime}"
model="${MODEL:-/root/models/Mellum2-12B-A2.5B-Thinking-MXFP4_MOE.gguf}"
ctx="${CTX:-131072}"

# Stagger startup based on GPU ID to prevent CPU/disk lock contention during Vulkan init
stagger=$((gpu_id * 3))
if [[ ${stagger} -gt 0 ]]; then
    echo "Staggering GPU ${gpu_id} startup by ${stagger} seconds..."
    sleep "${stagger}"
fi

echo "Starting Mellum2 12B MoE GPU ${gpu_id} Backend on port ${port} (128k context, Q8 KV)..."

export GGML_VK_VISIBLE_DEVICES="${gpu_id}"
export GGML_VK_ALLOW_GRAPHICS_QUEUE=1
export RADV_PERFTEST=nogttspill
export LLAMA_SERVER_OUTPUT_RESERVE=128
export LC_ALL=C

exec "${runtime}/bin/llama-server" \
  -m "${model}" \
  -ngl 99 \
  -fit off \
  --no-warmup \
  -fa on \
  --no-mmap \
  -c "${ctx}" \
  -np 1 \
  -ctk q8_0 \
  -ctv q8_0 \
  -b 1408 \
  -ub 384 \
  --cache-ram 0 \
  --ctx-checkpoints 0 \
  --host 0.0.0.0 \
  --port "${port}"
