+// Low-overhead scheduler critical-path tracer. It deliberately records only
+// host-side timestamps and prints once at process exit, so pipeline parallelism
+// and Vulkan command submission remain enabled and unmodified.
+struct ggml_sched_trace_stats {
+    uint64_t graphs;
+    uint64_t split_calls[GGML_SCHED_MAX_BACKENDS];
+    uint64_t input_bytes[GGML_SCHED_MAX_BACKENDS];
+    uint64_t event_wait_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t async_copy_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t fallback_src_sync_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t fallback_dst_sync_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t fallback_copy_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t submit_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t final_sync_us[GGML_SCHED_MAX_BACKENDS];
+    uint64_t async_copies[GGML_SCHED_MAX_BACKENDS];
+    uint64_t fallback_copies[GGML_SCHED_MAX_BACKENDS];
+};
+
+static ggml_sched_trace_stats g_sched_trace = {};
+
+static bool ggml_sched_trace_enabled() {
+    static const bool enabled = getenv("GGML_SCHED_CRITICAL_TRACE") != nullptr;
+    return enabled;
+}
+
+static void ggml_sched_trace_report() {
+    if (!ggml_sched_trace_enabled()) {
+        return;
+    }
+    fprintf(stderr, "GGML_SCHED_TRACE graphs=%llu\n", (unsigned long long) g_sched_trace.graphs);
+    for (int i = 0; i < GGML_SCHED_MAX_BACKENDS; ++i) {
+        if (g_sched_trace.split_calls[i] == 0 && g_sched_trace.final_sync_us[i] == 0) {
+            continue;
+        }
+        fprintf(stderr,
+            "GGML_SCHED_TRACE backend=%d splits=%llu bytes=%llu event_wait_us=%llu "
+            "async_copies=%llu async_copy_us=%llu fallback_copies=%llu "
+            "fallback_src_sync_us=%llu fallback_dst_sync_us=%llu fallback_copy_us=%llu "
+            "submit_us=%llu final_sync_us=%llu\n",
+            i,
+            (unsigned long long) g_sched_trace.split_calls[i],
+            (unsigned long long) g_sched_trace.input_bytes[i],
+            (unsigned long long) g_sched_trace.event_wait_us[i],
+            (unsigned long long) g_sched_trace.async_copies[i],
+            (unsigned long long) g_sched_trace.async_copy_us[i],
+            (unsigned long long) g_sched_trace.fallback_copies[i],
+            (unsigned long long) g_sched_trace.fallback_src_sync_us[i],
+            (unsigned long long) g_sched_trace.fallback_dst_sync_us[i],
+            (unsigned long long) g_sched_trace.fallback_copy_us[i],
+            (unsigned long long) g_sched_trace.submit_us[i],
+            (unsigned long long) g_sched_trace.final_sync_us[i]);
+    }
+}
+
+static void ggml_sched_trace_init() {
+    static const bool initialized = []() {
+        if (ggml_sched_trace_enabled()) {
+            atexit(ggml_sched_trace_report);
+        }
+        return true;
+    }();
+    (void) initialized;
+}
