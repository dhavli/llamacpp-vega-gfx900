index 5a9d0e7..2fe9400 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp
@@ -7,7 +7,11 @@
 
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
-#if !defined(DATA_A_F32) && !defined(DATA_A_F16) && !defined(DATA_A_BF16)
+#if defined(TERNARY_WIDE)
+// Binary/ternary formats use a dedicated wide path: 32 weights per thread per
+// iteration, loaded through the packed16 alias instead of per-byte accesses.
+#define K_PER_ITER 32
+#elif !defined(DATA_A_F32) && !defined(DATA_A_F16) && !defined(DATA_A_BF16)
 #define K_PER_ITER 8
 #else
 #define K_PER_ITER 4
@@ -42,6 +46,79 @@ vec4 load_b(const uint j, const uint iybs, const uint iqs, const bool lastiter,
     }
 }
 
+#if defined(TERNARY_WIDE)
+// Wide path for the binary/ternary formats (compiled only with TERNARY_WIDE,
+// selected by the backend for single-column dispatches). Each thread consumes 32 weights
+// per iteration: the quant bits arrive via two (Q1_0) or four (Q2_0) aligned
+// 16-bit loads instead of byte accesses, the 32 activations are staged in
+// registers once per column and reused for every row, and the dot product is
+// computed without materializing dequantized weights:
+//   Q1_0: sum((2t-1)*b) = 2*sum(t*b) - sum(b),   t in {0,1}
+//   Q2_0: sum((c-1)*b)  =   sum(c*b) - sum(b),   c in {0,1,2}
+// which is a single BFE+CVT+FMA per weight plus one correction per chunk.
+void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint tid, const uint i, bool lastiter)
+{
+    const uint col = i*BLOCK_SIZE + K_PER_ITER*tid;
+    if (col >= p.ncols) {
+        return; // tail chunk: ncols is a multiple of QUANT_K, not of K_PER_ITER*BLOCK_SIZE
+    }
+    const uint iqs = col%QUANT_K;
+
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        vec4 bv[8];
+        vec4 sumb4 = vec4(0.0f);
+        [[unroll]] for (uint x = 0; x < 8; ++x) {
+            bv[x] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + col) / 4 + x]);
+            sumb4 += bv[x];
+        }
+        const float sumb = sumb4.x + sumb4.y + sumb4.z + sumb4.w;
+
+        uint ibi = first_row*p.ncols;
+        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+            const uint ib = (ibi + col)/QUANT_K; // block index
+            ibi += p.ncols;
+
+#if defined(DATA_A_Q1_0)
+            const uint qsi = iqs/16;
+            const uint bits = uint(data_a_packed16[a_offset + ib].qs[qsi])
+                            | (uint(data_a_packed16[a_offset + ib].qs[qsi + 1]) << 16);
+            vec4 acc = vec4(0.0f);
+            [[unroll]] for (uint x = 0; x < 8; ++x) {
+                acc = fma(vec4(float((bits >> (4*x+0)) & 1u),
+                               float((bits >> (4*x+1)) & 1u),
+                               float((bits >> (4*x+2)) & 1u),
+                               float((bits >> (4*x+3)) & 1u)), bv[x], acc);
+            }
+            const float d = float(data_a_packed16[a_offset + ib].d);
+            const float t = acc.x + acc.y + acc.z + acc.w;
+            temp[j][n] += FLOAT_TYPE(d * fma(2.0f, t, -sumb));
+#else // DATA_A_Q2_0
+            const uint qsi = iqs/8;
+            const uint bits0 = uint(data_a_packed16[a_offset + ib].qs[qsi])
+                             | (uint(data_a_packed16[a_offset + ib].qs[qsi + 1]) << 16);
