+    // GCN is excluded from subgroup reductions by default; with only one wave64
+    // per workgroup the shmem tree reduction (7 barriers) is pure overhead there.
+    // GGML_VK_GCN_SUBGROUP_REDUCE=1 opts GCN into the subgroup path for A/B testing.
+    const bool gcn_subgroup_reduce = getenv("GGML_VK_GCN_SUBGROUP_REDUCE") != nullptr;
+    const bool use_subgroups = device->subgroup_arithmetic &&
