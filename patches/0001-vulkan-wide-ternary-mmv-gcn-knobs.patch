diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/sigglu.comp b/ggml/src/ggml-vulkan/vulkan-shaders/sigglu.comp
new file mode 100644
index 0000000..659bbf7
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/sigglu.comp
@@ -0,0 +1,37 @@
+#version 450
+
+#include "glu_head.glsl"
+
+// Fused UNARY(SIGMOID) + MUL: dst = sigmoid(a) * b.
+// Unlike the stock GLU split mode (which indexes b with a's strides), a may be
+// a row-strided view (e.g. a slice of a fused qkvz projection) while b shares
+// the contiguous layout of dst, so b is indexed with the dst stride group.
+float op(float a, float b) {
+    return b / (1.0f + exp(-a));
+}
+
+void main() {
+    const uint i = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+
+    if (i >= p.N) {
+        return;
+    }
+
+    // a may have a different (reshaped) logical shape than dst as long as the
+    // linear element order matches, so its index is derived from its own ne00.
+    const uint a_row = i / p.ne00;
+    const uint a_col = i - a_row * p.ne00;
+    const uint a_i3 = a_row / (p.ne01 * p.ne02);
+    const uint a_i2 = (a_row % (p.ne01 * p.ne02)) / p.ne01;
+    const uint a_i1 = a_row % p.ne01;
+    const uint src_idx = a_i3 * p.nb03 + a_i2 * p.nb02 + a_i1 * p.nb01 + a_col;
+
+    const uint row = i / p.ne20;
+    const uint col = i - row * p.ne20;
+    const uint dst_i3 = row / (p.ne11 * p.ne12);
+    const uint dst_i2 = (row % (p.ne11 * p.ne12)) / p.ne11;
+    const uint dst_i1 = row % p.ne11;
+    const uint dst_idx = dst_i3 * p.nb13 + dst_i2 * p.nb12 + dst_i1 * p.nb11 + col;
+
+    data_d[dst_idx] = D_TYPE(op(float(data_a[src_idx]), float(data_b[dst_idx])));
+}
