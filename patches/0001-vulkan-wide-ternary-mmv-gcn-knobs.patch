+    ggml_tensor * dst = cgraph->nodes[node_idx + ctx->num_additional_fused_ops]; // the MUL
+    const ggml_tensor * c0 = dst->src[0];
+    const ggml_tensor * c1 = dst->src[1];
+    const bool c0_is_gate = c0 == sig || (c0->op == GGML_OP_RESHAPE && c0->src[0] == sig);
+    const ggml_tensor * a = sig->src[0];
+    const ggml_tensor * b = c0_is_gate ? c1 : c0;
+
+    ggml_vk_op_f32<vk_op_glu_push_constants>(ctx, subctx, a, b, nullptr, nullptr, dst, GGML_OP_GLU,
+        {
+            (uint32_t)ggml_nelements(dst),
+            (uint32_t)a->ne[0],
+            (uint32_t)dst->ne[0],
+            2u,     // split mode
+            0.0f,
+            0.0f,
+            (uint32_t)(a->nb[1] / a->nb[0]),
+            (uint32_t)(a->nb[2] / a->nb[0]),
+            (uint32_t)(a->nb[3] / a->nb[0]),
+            (uint32_t)a->ne[1],
+            (uint32_t)a->ne[2],
+            (uint32_t)(dst->nb[1] / dst->nb[0]),
+            (uint32_t)(dst->nb[2] / dst->nb[0]),
+            (uint32_t)(dst->nb[3] / dst->nb[0]),
+            (uint32_t)dst->ne[1],
+            (uint32_t)dst->ne[2]
+        });
