+// GGML_VK_TERNARY_SOA=1: Q1_0 mul_mat weight tensors are repacked at upload
+// into groups of 64 blocks laid out [64 x f16 d][64 x 16B qs] so the matvec
+// reads one lane-coalesced dword per 32 weights instead of three scattered
+// sub-dword loads. token_embd.weight is excluded (read by GET_ROWS, and by the
+// tied lm_head).
+static bool ggml_vk_ternary_soa_enabled() {
+    static const bool en = getenv("GGML_VK_TERNARY_SOA") != nullptr;
+    return en;
+}
+
+static bool ggml_vk_tensor_is_q1_0_soa(const ggml_tensor * t) {
+    if (!ggml_vk_ternary_soa_enabled() || t == nullptr || t->type != GGML_TYPE_Q1_0) {
+        return false;
+    }
+    if (t->ne[2] != 1 || t->ne[3] != 1 || !ggml_is_contiguous(t)) {
+        return false;
+    }
+    const int64_t nblocks = ggml_nelements(t) / 128;
+    if (nblocks % 64 != 0) {
+        return false;
+    }
+    if (strcmp(t->name, "token_embd.weight") == 0) {
+        return false;
+    }
+    return true;
+}
+
+// AoS block_q1_0 (18 B: f16 d + 16 B qs) -> SoA groups of 64 blocks.
+static void ggml_vk_repack_q1_0_soa(const void * src, void * dst, size_t nblocks) {
+    const uint8_t * sp = (const uint8_t *) src;
+    uint8_t * dp = (uint8_t *) dst;
+    for (size_t g = 0; g < nblocks / 64; ++g) {
+        const uint8_t * sb = sp + g * 64 * 18;
+        uint8_t * db = dp + g * 1152;
+        for (int l = 0; l < 64; ++l) {
+            memcpy(db + 2 * l, sb + 18 * l, 2);
+            memcpy(db + 128 + 16 * l, sb + 18 * l + 2, 16);
+        }
+    }
+}
