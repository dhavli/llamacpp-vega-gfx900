+        // BM/BN. The shmem-support checks below validate the result.
+        const auto tile_env = [](const char * name, std::vector<uint32_t> & wt, std::array<uint32_t, 3> & denoms) {
+            const char * s = getenv(name);
+            if (s == nullptr) {
+                return;
+            }
+            std::vector<uint32_t> v;
+            const char * q = s;
+            while (*q) {
+                char * end;
+                unsigned long val = strtoul(q, &end, 10);
+                if (end == q) break;
+                v.push_back((uint32_t)val);
+                q = (*end == ',') ? end + 1 : end;
+            }
+            if (v.size() == 11) {
+                wt = v;
+                denoms = { v[1], v[2], 1 };
+                std::cerr << "ggml_vulkan: " << name << " warptile override {" << v[0] << "," << v[1] << "," << v[2] << "," << v[3] << "," << v[4] << "," << v[5] << "," << v[6] << "," << v[7] << "," << v[8] << "," << v[9] << "," << v[10] << "}" << std::endl;
+            } else {
+                std::cerr << "ggml_vulkan: ignoring " << name << " (need 11 comma-separated values, got " << v.size() << ")" << std::endl;
+            }
+        };
+        tile_env("GGML_VK_TILE_L", l_warptile_mmq, l_mmq_wg_denoms);
+        tile_env("GGML_VK_TILE_M", m_warptile_mmq, m_mmq_wg_denoms);
