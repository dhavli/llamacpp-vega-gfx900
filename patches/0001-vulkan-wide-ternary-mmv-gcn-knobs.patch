+    // Rows per workgroup for the ternary/binary formats (Q1_0/Q2_0).
+    // Default matches the other std quants (2*rm_stdq); overridable for tuning.
+    uint32_t rm_ter = 2 * rm_stdq;
+    if (const char * s = getenv("GGML_VK_TERNARY_ROWS")) {
+        rm_ter = std::max(1, std::min(16, atoi(s)));
