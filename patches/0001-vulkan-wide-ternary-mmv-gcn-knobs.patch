+static void ggml_vk_sigmoid_mul(ggml_backend_vk_context * ctx, vk_context& subctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    // Fused UNARY(SIGMOID) + MUL: dst = sigmoid(a) * b via the split-mode
+    // (mode==2) GLU shader with a sigmoid op. Shapes/layout validated by
+    // ggml_vk_can_fuse_sigmoid_mul.
